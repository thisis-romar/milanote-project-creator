#!/bin/bash
# @file pre-commit
# @description Universal pre-commit hook — typecheck, lint, sensitive file guard
# @standard project-management/standards/hooks.md
# @version 1.0.0
# @created 2026-04-29T00:00:00Z
# @lastUpdated 2026-04-29T00:00:00Z

set -euo pipefail

echo "pre-commit: running checks..."

# ── 1. Sensitive file guard ──────────────────────────────────
# Matches filenames only (not content). Use prepare-commit-msg for content patterns.
# Use end-anchors to avoid matching .env.example
BLOCKED_PATTERNS="\.env$|\.session\.json$|\.sqlite$|\.sqlite-shm$|\.sqlite-wal$"

staged_files=$(git diff --cached --name-only)

for f in $staged_files; do
  if echo "$f" | grep -qE "$BLOCKED_PATTERNS"; then
    echo "BLOCKED: '$f' matches a sensitive file pattern." >&2
    echo "Remove it from staging: git reset HEAD $f" >&2
    exit 1
  fi
done

# ── 2. TypeScript typecheck ──────────────────────────────────
if echo "$staged_files" | grep -qE '\.ts$'; then
  echo "pre-commit: typechecking..."
  npm run typecheck
fi

# ── 3. ESLint ────────────────────────────────────────────────
if echo "$staged_files" | grep -qE '\.(ts|js)$'; then
  echo "pre-commit: linting..."
  npm run lint
fi

echo "pre-commit: all checks passed."
