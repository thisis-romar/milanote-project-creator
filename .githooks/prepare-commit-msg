#!/bin/bash
# @file prepare-commit-msg
# @description Block sensitive patterns in commit messages
# @standard project-management/standards/hooks.md
# @version 1.0.0
# @created 2026-04-29T00:00:00Z
# @lastUpdated 2026-04-29T00:00:00Z

COMMIT_MSG_FILE="$1"

BLOCKED_PATTERNS=(
  "password"
  "secret"
  "api[._-]key"
  "token[[:space:]]*="
  "session[._-]cookie"
  "sessionKey"
  "Bearer "
  "MILANOTE_PASSWORD"
  "MILANOTE_EMAIL"
)

for pattern in "${BLOCKED_PATTERNS[@]}"; do
  if grep -iqE "$pattern" "$COMMIT_MSG_FILE"; then
    echo "BLOCKED: Commit message contains sensitive pattern: '$pattern'" >&2
    echo "Remove this language before committing." >&2
    exit 1
  fi
done

exit 0
