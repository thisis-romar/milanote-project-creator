{
  "name": "milanote-project-creator",
  "version": "0.1.0",
  "type": "module",
  "description": "Create Milanote boards programmatically from JSON templates",
  "bin": {
    "milanote-creator": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write src",
    "test": "vitest run",
    "test:watch": "vitest",
    "brain:build": "echo 'Run /graphify knowledge/milanote in Claude Code to rebuild the graph'",
    "brain:query": "python -m graphify query"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "ora": "^8.1.1",
    "playwright": "^1.50.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.28.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.22.0",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=20.12.2"
  }
}
