# Milanote credentials (used if not authenticated via CDP-attach)
MILANOTE_EMAIL=your@email.com
MILANOTE_PASSWORD=your_password

# Optional: override Edge user data directory for CDP attach
# EDGE_USER_DATA=C:\Users\YourUser\AppData\Local\Microsoft\Edge\User Data

# Optional: override CDP port (default: 9222)
# CDP_PORT=9222
